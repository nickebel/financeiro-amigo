{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["react", "vite/client"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["components/ui/**/*.tsx", "components/ui/**/*.d.ts"]
}
